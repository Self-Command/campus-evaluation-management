# 本地开发可运行 npm run dev:setup 自动生成真实随机凭据。
# 请勿直接使用占位符启动。
DATABASE_URL="postgresql://campus:REPLACE_WITH_RANDOM_PASSWORD@127.0.0.1:55432/campus_dev"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES"
# 只在本地开发数据库启用；生产环境必须禁用。
DEV_SEED_ENABLED="false"
# 可选：额外可信业务来源，逗号分隔。本机回环地址同协议同端口自动互认。
# APP_TRUSTED_ORIGINS="https://evaluation.example.edu.cn"
