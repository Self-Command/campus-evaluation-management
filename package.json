{
  "name": "campus-evaluation",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "predev": "prisma generate",
    "build": "prisma generate && next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:local": "tsx scripts/local-postgres.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed-dev.ts",
    "db:init-admin": "tsx scripts/init-admin.ts",
    "dev:setup": "tsx scripts/setup-env.ts",
    "test": "tsx scripts/test-integration.ts",
    "test:e2e": "playwright test",
    "cleanup:attachments": "tsx scripts/cleanup-activity-attachments.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^5.9.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tanstack/react-table": "^9.3.1",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "csv-parse": "7.0.3",
    "lucide-react": "0.577.0",
    "next": "16.4.2",
    "next-auth": "4.24.15",
    "pg": "8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "react-markdown": "^10.1.0",
    "read-excel-file": "9.3.12",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "yauzl": "3.4.0",
    "zod": "4.3.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^24",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yauzl": "3.4.0",
    "dotenv": "^17.3.1",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.2",
    "prisma": "7.10.1",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.0"
  }
}
