# Docker Compose environment template.
#
#   cp .env.docker.example .env.docker
#   chmod 600 .env.docker
#
# Fill every REQUIRED value before starting. Never commit .env.docker.
# Generate values locally, for example:
#   openssl rand -hex 24     # POSTGRES_PASSWORD (URL-safe)
#   openssl rand -base64 48  # NEXTAUTH_SECRET

# --- REQUIRED -------------------------------------------------------------
POSTGRES_DB=campus
POSTGRES_USER=campus
# Use letters, digits, dot, underscore or hyphen so the value is safe inside
# the generated DATABASE_URL. At least 24 random characters are recommended.
POSTGRES_PASSWORD=
# Signs sessions, captcha and export tokens. Must stay identical across
# replicas and restarts. 32+ random bytes.
NEXTAUTH_SECRET=
# Public origin users open in the browser, without a trailing slash.
NEXTAUTH_URL=http://localhost:3000

# --- Image / port ---------------------------------------------------------
APP_IMAGE=ghcr.io/self-command/campus-evaluation-management:latest
# Loopback is the safe default behind Nginx/Caddy. Use 0.0.0.0 only when the
# container port is published directly.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000
APP_VERSION=0.3.5
APP_REVISION=local

# --- Runtime --------------------------------------------------------------
TZ=Asia/Shanghai
# Apply pending Prisma migrations when the container starts.
RUN_MIGRATIONS=true
DB_WAIT_TIMEOUT_MS=60000

# --- First administrator (optional) --------------------------------------
# Used only when the database has no administrator yet. The account must
# change its password at first login. Clear the password after bootstrapping.
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=系统管理员

# --- Reverse proxy (optional) --------------------------------------------
# Extra origins allowed to call the application, comma separated.
# APP_TRUSTED_ORIGINS=https://evaluation.example.edu.cn
APP_TRUSTED_ORIGINS=
# Trust the right-most X-Forwarded-For address. Enable only when a trusted
# reverse proxy overwrites the header; audit logs use it for client IPs.
TRUST_PROXY=false

# --- Database backups ----------------------------------------------------
# Maximum uploaded backup size in bytes. Capped at 2 GiB by the application.
BACKUP_MAX_BYTES=2147483648
